{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Required: @huggingface/transformers and @huggingface/tokenizers ship .d.ts files
    // with NodeNext-incompatible relative imports and internal type mismatches we cannot patch.
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out", "src/test/integration", "src/**/__corpus__/**"]
}

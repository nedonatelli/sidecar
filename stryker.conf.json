{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Verify-the-verifier audit (\u00a74): mutation-test SideCar's own moat-critical modules to confirm their tests catch faults, not just pass. One-time / on-demand \u2014 not CI (too slow). Scope via `mutate`.",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "ignorePatterns": [
    ".vscode-test",
    ".vscode-test-web",
    "out",
    "dist",
    "coverage",
    "*.vsix",
    "swe_campaign_*",
    ".sidecar",
    ".stryker-tmp",
    "reports",
    "docs"
  ],
  "mutate": [
    "src/agent/citationCheck.ts",
    "src/agent/completionGate.ts",
    "src/agent/completionGate/reprompts.ts",
    "src/agent/completionGate/behavioralReprompt.ts",
    "src/agent/completionGate/pathUtil.ts",
    "src/agent/loop/keepBestRatchet.ts",
    "src/agent/loop/textParsing.ts",
    "src/agent/loop/forceFinalAnswer.ts",
    "src/agent/loop/unappliedEdit.ts",
    "src/agent/analyticBounds.ts",
    "src/agent/injectionGuard.ts",
    "src/agent/jsonRepair.ts",
    "src/agent/plans/externalPlan.ts",
    "src/agent/executor/paramRemap.ts",
    "src/agent/executor/toolNameAlias.ts",
    "src/agent/executor/exampleReplayGuard.ts",
    "src/agent/executor/bounceEscalation.ts",
    "src/agent/loop/actionReprompt.ts",
    "src/agent/delimiters.ts",
    "src/agent/tools/pythonIndent.ts",
    "src/agent/modelPerformance.ts",
    "src/agent/failureTaxonomy.ts",
    "src/agent/scaffoldingProfile.ts"
  ],
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 0
  }
}

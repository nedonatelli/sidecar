.vscode/**
.claude/**
# Private working docs — gitignored, must NEVER ship in the .vsix
# (verify-package.mjs hard-fails if any internal/ path is packaged).
internal/**
.sidecar/**
src/**
out/**
node_modules/**
!node_modules/web-tree-sitter/**
# playwright-core -- externalized from the esbuild bundle and require()d at
# runtime by the visual-verify tools (screenshot_page). It used to be a
# devDependency that never shipped, so in every installed SideCar the tool
# stopped at "playwright-core is not installed". It ships no browser; the tools
# drive an installed Chrome/Edge (src/agent/tools/browserLaunch.ts).
# Listed path by path because a later exclude cannot undo a negation in vsce 3.9:
# left out are types/, index.d.ts, README, bin/, cli.js and lib/vite/ (the trace
# viewer UI) -- launch + page and element screenshots were verified on Chrome and
# Edge with exactly this set (412 files). LICENSE/NOTICE ship as Apache-2.0 requires.
!node_modules/playwright-core/package.json
!node_modules/playwright-core/index.js
!node_modules/playwright-core/index.mjs
!node_modules/playwright-core/browsers.json
!node_modules/playwright-core/LICENSE
!node_modules/playwright-core/NOTICE
!node_modules/playwright-core/ThirdPartyNotices.txt
!node_modules/playwright-core/lib/*.js
!node_modules/playwright-core/lib/cli/**
!node_modules/playwright-core/lib/client/**
!node_modules/playwright-core/lib/generated/**
!node_modules/playwright-core/lib/protocol/**
!node_modules/playwright-core/lib/remote/**
!node_modules/playwright-core/lib/server/**
!node_modules/playwright-core/lib/third_party/**
!node_modules/playwright-core/lib/tools/**
!node_modules/playwright-core/lib/utils/**
!node_modules/playwright-core/lib/utilsBundleImpl/**
# @lancedb (~92 MB) is NOT bundled: the Project Knowledge backend defaults to
# 'flat', and LanceVectorStore require()s '@lancedb/lancedb' lazily and falls
# back to flat with a warning when absent (see config/vectorStore.ts,
# activation/workspaceIndexer.ts). Bundling it would nearly double the .vsix for
# an opt-in, non-default backend. Users who set backend: 'lance' install it themselves.
# Local embedding runtime (@huggingface/transformers) — externalized from the
# esbuild bundle and dynamic-imported at runtime, so it MUST ship in the .vsix.
# Without it, PKI symbol/file embeddings fail to load ("Cannot find package
# '@huggingface/transformers'") and silently fall back to the file-level index.
# vsce negations take precedence, so we re-include ONLY what the Node build
# (dist/transformers.node.mjs) actually loads — not the 379 MB full tree.
!node_modules/@huggingface/transformers/package.json
!node_modules/@huggingface/transformers/dist/**
!node_modules/@huggingface/transformers/node_modules/@huggingface/**
!node_modules/@huggingface/transformers/node_modules/onnxruntime-common/**
!node_modules/@huggingface/transformers/node_modules/flatbuffers/**
# onnxruntime-node: JS loader + native bindings. The npm package bundles all
# platforms (darwin/linux/win32) in bin/. Re-including the whole bin/ tree
# keeps a LOCAL `npm run package` working on any OS; the publish workflow
# builds per target and runs scripts/prune-onnxruntime-platforms.mjs first, so
# a released .vsix carries one platform. (A later plain exclude cannot undo a
# negation in vsce 3.9 -- the GPU providers are prevented at install time via
# ONNXRUNTIME_NODE_INSTALL=skip and asserted by verify-package, not ignored.)
# Skips onnxruntime-web (browser/WASM, not imported by the node build).
!node_modules/@huggingface/transformers/node_modules/onnxruntime-node/package.json
!node_modules/@huggingface/transformers/node_modules/onnxruntime-node/dist/**
!node_modules/@huggingface/transformers/node_modules/onnxruntime-node/lib/**
!node_modules/@huggingface/transformers/node_modules/onnxruntime-node/script/**
!node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/**
# top-level tokenizers (imported by the node build).
!node_modules/@huggingface/tokenizers/**
# sharp — statically imported by transformers.node.mjs (even for text), so it must
# load. @img holds sharp's native binaries and npm installs ONLY the build host's
# platform, so the .vsix is platform-specific for sharp — publish per-platform via
# `vsce package --target <platform>` (see .github/workflows/publish.yml).
!node_modules/@huggingface/transformers/node_modules/sharp/**
!node_modules/@img/**
!node_modules/detect-libc/**
!node_modules/semver/**
.gitignore
tsconfig.json
**/*.ts
**/*.map
*.md
!README.md
!CHANGELOG.md
!media/walkthroughs/**
.sidecar/**
coverage/**
docs/**
examples/**
tests/**
scripts/**
skills/fabric/**
vitest.config.ts
vitest.*.config.ts
eslint.config.mjs
*.vsix
.vscode-test/**
.vscode-test.mjs
.prettierignore
*.log
stryker.conf.json
tsconfig.bench.json
bench/**
.husky/**
.github/**

# Python virtualenvs. `.graphify-venv` (created for the code-graph differential)
# put 4,181 files and 139 MB into the 0.122.4 VSIX before anyone looked at the
# packaged tree — `.gitignore` covers it, `.vscodeignore` is a separate list and
# did not. Matched by the packages directory too, so a venv under any name is
# caught rather than the two conventional ones.
**/.venv/**
**/venv/**
**/*-venv/**
**/site-packages/**
**/dist-packages/**
